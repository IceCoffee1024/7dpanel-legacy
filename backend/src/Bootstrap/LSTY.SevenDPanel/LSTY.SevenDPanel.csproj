<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LSTY.SevenDPanel</AssemblyName>
    <RootNamespace>LSTY.SevenDPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <ProjectReference Include="..\..\Core\LSTY.SevenDPanel.Application\LSTY.SevenDPanel.Application.csproj" />
    <ProjectReference Include="..\..\Runtime\LSTY.SevenDPanel.Hosting\LSTY.SevenDPanel.Hosting.csproj" />
    <ProjectReference Include="..\..\Adapters\LSTY.SevenDPanel.Adapters.Persistence.Sqlite\LSTY.SevenDPanel.Adapters.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Adapters\LSTY.SevenDPanel.Adapters.Web\LSTY.SevenDPanel.Adapters.Web.csproj" />
    <ProjectReference Include="..\..\Adapters\LSTY.SevenDPanel.Adapters.SevenDays\LSTY.SevenDPanel.Adapters.SevenDays.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SevenDaysHarmonyDirectory)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDaysManagedDirectory)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(SevenDaysManagedDirectory)\LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SevenDaysManagedDirectory)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp">
      <Private>true</Private>
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\Microsoft.CSharp.dll</HintPath>
    </Reference>
    <Reference Include="System.Reflection.Emit">
      <Private>true</Private>
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Reflection.Emit.dll</HintPath>
    </Reference>
    <Reference Include="System.Dynamic">
      <Private>true</Private>
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Dynamic.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.DataAnnotations">
      <Private>true</Private>
      <HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.ComponentModel.DataAnnotations.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSevenDaysBootstrapReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(SevenDaysHarmonyDirectory)\0Harmony.dll')"
      Text="7DTD 0_TFP_Harmony/0Harmony.dll was not found under $(SevenDaysHarmonyDirectory). Initialize the reference submodule or override SevenDaysGameVersion and SevenDaysReferenceRoot." />
    <Error
      Condition="!Exists('$(SevenDaysManagedDirectory)\Assembly-CSharp.dll')"
      Text="7DTD Assembly-CSharp.dll was not found under $(SevenDaysManagedDirectory). Initialize the reference submodule or override SevenDaysGameVersion and SevenDaysReferenceRoot." />
    <Error
      Condition="!Exists('$(SevenDaysManagedDirectory)\Newtonsoft.Json.dll')"
      Text="7DTD Newtonsoft.Json.dll was not found under $(SevenDaysManagedDirectory). Initialize the reference submodule or override SevenDaysGameVersion and SevenDaysReferenceRoot." />
    <Error
      Condition="!Exists('$(SevenDaysManagedDirectory)\LogLibrary.dll')"
      Text="7DTD LogLibrary.dll was not found under $(SevenDaysManagedDirectory). Initialize the reference submodule or override SevenDaysGameVersion and SevenDaysReferenceRoot." />
  </Target>

  <ItemGroup>
    <None Include="ModInfo.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.InteropServices.RuntimeInformation.dll"
          Visible="false"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
