# Copy this file to .env.local and adjust values for your machine.
# Do not commit .env.local. It is ignored by Git.
#
# Runtime listener settings do not belong here. Edit the deployed Mod's
# config.json instead. These variables are only used by the helper scripts.

# -----------------------------------------------------------------------------
# Publish target
# -----------------------------------------------------------------------------
# Optional. When empty, Publish-Mod uses the standard FolderProfile output:
# backend/src/LSTY.SevenDPanel/bin/Release/net48/publish/
# Set this to a local or mounted remote Mod directory for direct publishing.
# Example: D:\7 Days to Die Server\Mods\7DPanel
# Example: \\server\share\7DaysToDie\Mods\7DPanel
SEVENDPANEL_PUBLISH_DIR=

# -----------------------------------------------------------------------------
# Health check target
# -----------------------------------------------------------------------------
# Used by Test-HealthEndpoint. This does not change the Mod listener.
SEVENDPANEL_HEALTH_URL=http://127.0.0.1:18080/health

# -----------------------------------------------------------------------------
# Local server startup
# -----------------------------------------------------------------------------
# Used when Start-Server runs without -ComputerName, or with -Local.
SEVENDPANEL_LOCAL_SERVER_ROOT=

# -----------------------------------------------------------------------------
# Remote server startup
# -----------------------------------------------------------------------------
# Used when SEVENDPANEL_REMOTE_COMPUTER is set.
# The remote machine must allow PowerShell Remoting (WinRM).
SEVENDPANEL_REMOTE_COMPUTER=
SEVENDPANEL_REMOTE_SERVER_ROOT=

# Telnet is local-only when TelnetPassword is empty. Stop-Server sends the
# graceful `shutdown` command to this port on the target machine.
SEVENDPANEL_TELNET_PORT=8081

# The startup file is fixed as startdedicated.bat and is not configurable here.
# WinRM uses the current or cached Windows credentials for remote execution.
# Remote startup maintains an on-demand task named 7DPanel-Start-7DTD on the
# target machine. The task runs as the authenticated remote user via S4U and
# does not store a password.
# For an IP-based workgroup connection, configure TrustedHosts once in an
# elevated PowerShell on this development machine; do not use '*' casually:
# Set-Item WSMan:\localhost\Client\TrustedHosts -Value '<REMOTE_IP>' -Concatenate -Force
