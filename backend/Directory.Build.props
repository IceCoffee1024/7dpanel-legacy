<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <SevenDaysGameVersion Condition="'$(SevenDaysGameVersion)' == ''">v3.0.1-b4</SevenDaysGameVersion>
    <SevenDaysReferenceRoot Condition="'$(SevenDaysReferenceRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\7dtd-reference'))</SevenDaysReferenceRoot>
    <SevenDaysRuntimeDirectory Condition="'$(SevenDaysRuntimeDirectory)' == ''">$(SevenDaysReferenceRoot)\$(SevenDaysGameVersion)\runtime</SevenDaysRuntimeDirectory>
    <SevenDaysManagedDirectory Condition="'$(SevenDaysManagedDirectory)' == ''">$(SevenDaysRuntimeDirectory)\7DaysToDieServer_Data\Managed</SevenDaysManagedDirectory>
    <SevenDaysHarmonyDirectory Condition="'$(SevenDaysHarmonyDirectory)' == ''">$(SevenDaysRuntimeDirectory)\Mods\0_TFP_Harmony</SevenDaysHarmonyDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
