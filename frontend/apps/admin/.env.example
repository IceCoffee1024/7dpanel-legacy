# Development-only Vite proxy target. Browser code always uses relative /api paths.
VITE_BACKEND_URL=http://127.0.0.1:18080

# Real OWIN Playwright environment. Microsoft Edge is the default browser.
SEVENDPANEL_ADMIN_URL=http://localhost:5173/
PANEL_USERNAME=admin
PANEL_PASSWORD=password
SEVENDPANEL_E2E_BROWSER=msedge
